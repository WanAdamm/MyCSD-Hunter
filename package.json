{
  "name": "mycsd-hunter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run export:static && vite",
    "build": "npm run export:static && vite build",
